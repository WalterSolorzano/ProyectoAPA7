<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/2.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.1"
  xsi:type="TaskPaneApp">

  <!-- ===================================================================== -->
  <!-- WordAPA7 — Word Add-in Manifest                                        -->
  <!-- Panel lateral (Task Pane) que vive DENTRO de Word. Implementa el        -->
  <!-- "Asistente en Vivo" que edita el documento en APA 7 en tiempo real:   -->
  <!-- detecta y guarda citas, aplica formato al vuelo y numera figuras/      -->
  <!-- tablas automáticamente al pegar imágenes o tablas.                     -->
  <!--                                                                        -->
  <!-- Además, la pestaña "WordAPA7" del Ribbon tiene botones de acceso       -->
  <!-- rápido que abren el panel directamente en la sección correcta.         -->
  <!-- ===================================================================== -->

  <!-- El Id DEBE ser un GUID válido (Word lo exige para hacer sideload). -->
  <Id>8f3a2c1d-9b4e-4a7f-8c5d-2e1f0a3b6c9d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>WordAPA7</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="WordAPA7 — Asistente APA 7" />
  <Description DefaultValue="Asistente APA 7 en vivo dentro de Word: detecta citas, aplica formato APA 7 al vuelo y numera figuras y tablas automáticamente cuando las pegás." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://localhost:3000" />

  <!-- Hosts: solo Word -->
  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <!-- Requisitos: Word 2016+ o Word Online -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <!-- Ubicación del Task Pane (el asistente en vivo) -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>

  <!-- Permisos: lectura/escritura del documento -->
  <Permissions>ReadWriteDocument</Permissions>

  <!-- ===================================================================== -->
  <!-- Version Overrides — pestaña del Ribbon con botones de acceso rápido   -->
  <!-- ===================================================================== -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.1" xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="WordAPA7.GetStarted.Title" />
            <Description resid="WordAPA7.GetStarted.Description" />
            <LearnMoreUrl resid="WordAPA7.LearnMoreUrl" />
          </GetStarted>

          <!-- FunctionFile: HTML invisible que carga las funciones JS del ribbon -->
          <FunctionFile resid="WordAPA7.Commands.Url" />

          <!-- Pestaña personalizada "WordAPA7" con grupos de botones -->
          <ExtensionPoint xsi:type="CustomTab">
            <CustomTab id="WordAPA7.Tab">
              <Label resid="WordAPA7.TabLabel" />

              <!-- Grupo 1: Asistente -->
              <Group id="WordAPA7.GroupAssistant">
                <Label resid="WordAPA7.GroupAssistantLabel" />

                <!-- Botón principal: abre el Task Pane (asistente en vivo) -->
                <Control xsi:type="Button" id="WordAPA7.OpenTaskpane">
                  <Label resid="WordAPA7.TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.TaskpaneButton.Label" />
                    <Description resid="WordAPA7.TaskpaneButton.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WordAPA7.Taskpane</TaskpaneId>
                    <SourceLocation resid="WordAPA7.Taskpane.Url" />
                  </Action>
                </Control>

                <!-- Auditar APA 7: abre el panel en la pestaña "En Vivo" -->
                <Control xsi:type="Button" id="WordAPA7.Audit">
                  <Label resid="WordAPA7.Audit.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Audit.Label" />
                    <Description resid="WordAPA7.Audit.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>validateSelection</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Grupo 2: Insertar elementos APA 7 -->
              <Group id="WordAPA7.GroupInsert">
                <Label resid="WordAPA7.GroupInsertLabel" />

                <!-- Insertar Tabla APA -->
                <Control xsi:type="Button" id="WordAPA7.InsertTable">
                  <Label resid="WordAPA7.InsertTable.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.InsertTable.Label" />
                    <Description resid="WordAPA7.InsertTable.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertTableAPA</FunctionName>
                  </Action>
                </Control>

                <!-- Insertar Figura APA -->
                <Control xsi:type="Button" id="WordAPA7.InsertFigure">
                  <Label resid="WordAPA7.InsertFigure.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.InsertFigure.Label" />
                    <Description resid="WordAPA7.InsertFigure.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertFigureAPA</FunctionName>
                  </Action>
                </Control>

                <!-- Insertar Título APA -->
                <Control xsi:type="Button" id="WordAPA7.InsertHeading">
                  <Label resid="WordAPA7.InsertHeading.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.InsertHeading.Label" />
                    <Description resid="WordAPA7.InsertHeading.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertHeadingAPA</FunctionName>
                  </Action>
                </Control>
              </Group>

            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Recursos (strings, URLs, iconos) -->
    <Resources>
      <bt:Images>
        <bt:Image id="WordAPA7.Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="WordAPA7.Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="WordAPA7.Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>

      <bt:Urls>
        <bt:Url id="WordAPA7.Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
        <bt:Url id="WordAPA7.Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="WordAPA7.LearnMoreUrl" DefaultValue="https://localhost:3000" />
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="WordAPA7.GetStarted.Title" DefaultValue="WordAPA7 — Tu asistente APA 7 dentro de Word" />
        <bt:String id="WordAPA7.TaskpaneButton.Label" DefaultValue="Abrir panel" />
        <bt:String id="WordAPA7.TabLabel" DefaultValue="WordAPA7" />
        <bt:String id="WordAPA7.GroupAssistantLabel" DefaultValue="Asistente" />
        <bt:String id="WordAPA7.GroupInsertLabel" DefaultValue="Insertar APA 7" />
        <bt:String id="WordAPA7.Audit.Label" DefaultValue="Auditar APA 7" />
        <bt:String id="WordAPA7.InsertTable.Label" DefaultValue="Tabla" />
        <bt:String id="WordAPA7.InsertFigure.Label" DefaultValue="Figura" />
        <bt:String id="WordAPA7.InsertHeading.Label" DefaultValue="Título" />
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="WordAPA7.Description" DefaultValue="Asistente APA 7 en vivo: detecta citas, aplica formato APA 7 al vuelo y numera figuras y tablas automáticamente cuando las pegás." />
        <bt:String id="WordAPA7.GetStarted.Description" DefaultValue="Abrí el panel lateral de WordAPA7 para editar tu documento con formato APA 7 en tiempo real. El asistente detecta citas, aplica formato y numera figuras y tablas al pegar." />
        <bt:String id="WordAPA7.TaskpaneButton.Supertip" DefaultValue="Abre el asistente APA 7 en el panel lateral. Detecta citas, aplica formato APA 7 al vuelo y numera figuras y tablas automáticamente al pegar, sin salir de Word." />
        <bt:String id="WordAPA7.Audit.Supertip" DefaultValue="Audita tu documento contra las normas APA 7: detecta citas, formato y problemas de estilo en tiempo real." />
        <bt:String id="WordAPA7.InsertTable.Supertip" DefaultValue="Abre el panel en la sección de tablas APA 7: definí encabezados, título y nota; la numeración es automática." />
        <bt:String id="WordAPA7.InsertFigure.Supertip" DefaultValue="Abre el panel en la sección de figuras APA 7: subí una imagen y se inserta con numeración, título en cursiva y nota automáticamente." />
        <bt:String id="WordAPA7.InsertHeading.Supertip" DefaultValue="Abre el panel en la sección de títulos APA 7: elegí el nivel (1-5) y se inserta con el formato correcto." />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
